{
  "name": "zuzify-discord-bot",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Standalone Zuzify ecosystem Discord bot",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/register-commands.js && node dist/index.js",
    "commands": "tsx src/register-commands.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.76.1",
    "discord.js": "14.22.1",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
